# Override the auto-detected API base URL.
# - Netlify deploys auto-detect the Vercel backend.
# - Same-host deploys (atlas.meteo.gov.gh) default to /api.
# - Local dev defaults to http://127.0.0.1:8001/api.
# VITE_API_URL=/api

# Show the public site pages (Overview, Dashboard, ...) in a build. Off by
# default so deployed builds are map-only until the design is approved; the dev
# server turns it on through .env.development.
# VITE_PUBLIC_SITE_ENABLED=true
